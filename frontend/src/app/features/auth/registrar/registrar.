<div class="login-container">
  <div class="login-card">
    <div class="login-header">
      <h2>Criar Conta</h2>
      <p class="subtitle">VitaControl - Gestão de Saúde</p>
    </div>

    <div *ngIf="errorMessage" class="alert error-alert">
      {{ errorMessage }}
    </div>
    <div *ngIf="successMessage" class="alert success-alert">
      {{ successMessage }}
    </div>

    <form [formGroup]="registrarForm" (ngSubmit)="onSubmit()">
      <div class="input-group">
        <label for="nome">Nome Completo</label>
        <input type="text" id="nome" formControlName="nomeCompleto" placeholder="Digite seu nome">
      </div>

      <div class="input-group">
        <label for="email">E-mail</label>
        <input type="email" id="email" formControlName="email" placeholder="seu@email.com">
      </div>

      <div class="input-group" style="position: relative;">
        <label for="senha">Senha</label>
        <div style="position: relative; display: flex; align-items: center;">
          <input 
            type="password"
            id="senha"
            formControlName="senha"
            placeholder="Mínimo 6 caracteres"
            required
            style="width: 100%; padding-right: 45px;"
          />
        </div>
      </div>

      <button type="submit" class="btn-login" [disabled]="loading">
        {{ loading ? 'Cadastrando...' : 'Registrar' }}
      </button>
    </form>

    <div class="login-footer">
      <p>Já tem uma conta? <a routerLink="/auth/login">Faça Login</a></p>
      <p class="developer-signature">desenvolvedor: Glailton Nascimento</p>
    </div>
  </div>
</div>

